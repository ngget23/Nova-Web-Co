# ---- Server ----
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# ---- Text message alerts (Twilio) ----
# Get these from https://console.twilio.com
# Without them the site still works and still saves leads - it just won't text.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# The Twilio number you bought, in E.164 format
TWILIO_FROM_NUMBER=+16135550123
# YOUR phone - where the "new lead" texts land.
# Comma-separate to alert more than one phone.
ALERT_SMS_TO=+16135559876

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
SUCCESS_URL=http://localhost:5173/success.html
CANCEL_URL=http://localhost:5173/cancel.html

# ---- Email backup copy (optional) ----
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=you@example.com
EMAIL_PASS=your_app_password
ORDER_RECEIVER_EMAIL=you@example.com
